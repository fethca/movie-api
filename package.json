{
  "name": "movie-api",
  "version": "0.0.8",
  "description": "",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "format": "prettier -w \"{src,tests}/**/*.{ts,tsx}\"",
    "lint": "eslint \"{src,tests}/**/*.{ts,tsx}\"",
    "test:unit": "vitest run --coverage",
    "start:dev": "nodemon -r dotenv/config --inspect=9994 src/index.ts",
    "version:patch": "fethca-version patch",
    "version:minor": "fethca-version minor",
    "version:major": "fethca-version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fethca/movie-api.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fethca/movie-api/issues"
  },
  "homepage": "https://github.com/fethca/movie-api#readme",
  "dependencies": {
    "@fethcat/config": "^0.0.5",
    "@fethcat/logger": "^1.0.3",
    "@fethcat/shared": "^0.0.17",
    "@fethcat/validator": "^0.0.6",
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "domutils": "^3.2.2",
    "dotenv": "^16.6.1",
    "envalid": "^8.2.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "fuse.js": "^7.5.0",
    "helmet": "^7.2.0",
    "htmlparser2": "^9.1.0",
    "lodash.get": "^4.4.2",
    "mongoose": "^8.24.11",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fethcat/eslint-plugin": "^0.0.3",
    "@fethcat/prettier-config": "^1.0.5",
    "@fethcat/tests": "^0.0.16",
    "@fethcat/version": "^0.0.17",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "prettier": "@fethcat/prettier-config",
  "nodemonConfig": {
    "restartable": "rs",
    "ignore": [
      ".git",
      "node_modules/**/node_modules"
    ],
    "execMap": {
      "ts": "tsx"
    },
    "watch": [
      "src/"
    ],
    "ext": "js,json,ts"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@fethcat/back"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
